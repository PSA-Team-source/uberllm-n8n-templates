              "value": "fal-ai/veo3.1/fast",
              "type": "string"
            },
            {
              "id": "dc7b7d67-2415-5654-a93b-d97e9492da88",
              "name": "duration_seconds",
              "value": 8,
              "type": "number"
            },
            {
              "id": "83caa6d4-d249-5d84-850a-236e40882205",
              "name": "resolution",
              "value": "720p",
              "type": "string"
            },
            {
              "id": "56b8409c-ee71-5160-8166-181a05bd7724",
              "name": "aspect_ratio",
              "value": "16:9",
              "type": "string"
            },
            {
              "id": "ed20a9fc-73bf-58fe-a2f4-70fad5b94be5",
              "name": "audio",
              "value": true,
              "type": "boolean"
            },
            {
              "id": "bc70f573-6576-50ea-a6d9-35d11e96352e",
              "name": "max_cost",
