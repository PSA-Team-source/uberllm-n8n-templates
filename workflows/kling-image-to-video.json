        "jsonBody": "={{ JSON.stringify({ model: $json.model, prompt: $json.prompt, image_url: $json.image_url, duration_seconds: $json.duration_seconds, audio: $json.audio, max_cost: $json.max_cost, metadata: { template: 'kling-image-to-video' } }) }}",
