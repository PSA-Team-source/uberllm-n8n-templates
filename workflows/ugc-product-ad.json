      "parameters": {
        "method": "POST",
        "url": "https://api.uberllm.dev/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-UberLLM-Source",
              "value": "n8n"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.vision_model, max_tokens: 2000, temperature: 0.8, messages: [{ role: 'system', content: \"You plan short UGC-style product ads (a real person filming on a phone). Look at the product photo and answer with JSON only: {\\\"scene_prompt\\\": string, \\\"motion_prompt\\\": string, \\\"hook\\\": string, \\\"caption\\\": string}. scene_prompt: an edit instruction that puts this exact product (keep its label, shape and colours) in the hand of a creator who fits the audience, filming a selfie-style vertical shot in a real home setting, natural light, phone-camera look. motion_prompt: how the person and camera move in a 5-second clip (e.g. lifts the product to the camera and smiles). hook: the first spoken line. caption: the post caption.\" }, { role: 'user', content: [{ type: 'text', text: 'Product: ' + $json.product_name + '. Audience: ' + $json.audience + '.' }, { type: 'image_url', image_url: { url: $json.product_image_url } }] }], response_format: { type: 'json_object' } }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "3e893767-3620-5f60-9d3e-98ea4a1e7389",
      "name": "Plan the ad",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "uberllmApiKey01",
          "name": "UberLLM API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// The model was asked for JSON. Read it even if it wrapped it in a code fence.\nconst text = $json.choices?.[0]?.message?.content ?? '';\nconst match = text.match(/\\{[\\s\\S]*\\}/);\nif (!match) throw new Error('The chat model did not answer with JSON: ' + text.slice(0, 200));\nreturn { json: JSON.parse(match[0]) };",
        "mode": "runOnceForEachItem"
      },
      "id": "b3487d6c-053d-5e8f-a5e6-c55c907a443a",
