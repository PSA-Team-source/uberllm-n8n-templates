      "parameters": {
        "method": "POST",
        "url": "https://api.uberllm.dev/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-UberLLM-Source",
              "value": "n8n"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $json.chat_model, max_tokens: 1500, temperature: 0.8, messages: [{ role: 'system', content: \"You write faceless short-form videos (YouTube Shorts, TikTok, Reels). Answer with JSON only: {\\\"title\\\": string, \\\"caption\\\": string, \\\"hashtags\\\": string, \\\"scenes\\\": [{\\\"narration\\\": string, \\\"image_prompt\\\": string, \\\"motion_prompt\\\": string}]}. Each scene is one vertical shot of about 6 seconds. image_prompt describes one still frame in detail (subject, setting, light, style, vertical 9:16, no text in the picture). motion_prompt says how the camera and subject move in that shot. narration is one short spoken line.\" }, { role: 'user', content: 'Topic: ' + $json.topic + '. Write exactly ' + $json.scenes + ' scenes.' }], response_format: { type: 'json_object' } }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "41c2372a-7795-5885-80c7-a750e3e04e6d",
      "name": "Write script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "uberllmApiKey01",
          "name": "UberLLM API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// One item per scene, at most the number of scenes asked for in Settings.\nconst text = $json.choices?.[0]?.message?.content ?? '';\nconst match = text.match(/\\{[\\s\\S]*\\}/);\nif (!match) throw new Error('The chat model did not answer with JSON: ' + text.slice(0, 200));\nconst script = JSON.parse(match[0]);\nconst want = Number($('Settings').first().json.scenes) || 3;\nconst scenes = (script.scenes || []).slice(0, want);\nif (!scenes.length) throw new Error('The script has no scenes.');\nreturn scenes.map((s, i) => ({ json: { scene: i + 1, ...s } }));"
      },
